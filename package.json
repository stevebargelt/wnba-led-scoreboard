{
  "name": "wnba-led-scoreboard",
  "version": "1.0.0",
  "description": "Multi-league LED scoreboard with web admin",
  "private": true,
  "scripts": {
    "test": "cd web-admin && npm test",
    "test:web": "cd web-admin && npm test",
    "test:coverage": "cd web-admin && npm run test:coverage",
    "test:web:coverage": "cd web-admin && npm run test:coverage",
    "test:all": "cd web-admin && npm run test:ci",
    "test:watch": "cd web-admin && npm run test:watch",
    "lint": "cd web-admin && npm run lint",
    "lint:fix": "cd web-admin && npm run lint:fix",
    "format": "cd web-admin && npm run format",
    "dev": "cd web-admin && npm run dev",
    "build": "cd web-admin && npm run build",
    "install:all": "cd web-admin && npm ci",
    "clean": "cd web-admin && rm -rf .next node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevebargelt/wnba-led-scoreboard.git"
  },
  "keywords": [
    "led",
    "scoreboard",
    "sports",
    "wnba",
    "nhl",
    "raspberry-pi"
  ],
  "author": "Steve Bargelt",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stevebargelt/wnba-led-scoreboard/issues"
  },
  "homepage": "https://github.com/stevebargelt/wnba-led-scoreboard#readme"
}